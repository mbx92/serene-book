DATABASE_URL=postgresql://spa:spa_local_password@localhost:5432/spa_management
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_URL=http://localhost:3000
SEED_PASSWORD=change-this-demo-password

# Production / Coolify: see compose.coolify.yaml and docs/deployment-coolify.md.
# Forwarded headers are ignored locally. Enable only behind trusted proxy hops.
TRUST_PROXY_HOPS=0
BOOKING_RATE_LIMIT_IP_MAX=5
BOOKING_RATE_LIMIT_IP_WINDOW_SECONDS=900
BOOKING_RATE_LIMIT_PHONE_MAX=3
BOOKING_RATE_LIMIT_PHONE_WINDOW_SECONDS=3600
BOOKING_RATE_LIMIT_GLOBAL_MAX=120
BOOKING_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# Optional: override map tile provider and its required attribution.
# NUXT_PUBLIC_MAP_TILE_URL=https://your-provider.example/{z}/{x}/{y}.png
# NUXT_PUBLIC_MAP_ATTRIBUTION=Provider attribution
